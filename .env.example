# ===================================================================
# CareLink Frontend - Environment Configuration Example
# ===================================================================
# Copy file này thành `.env` hoặc `.env.local` để điều chỉnh cấu hình theo nhu cầu:
#
# 1. Chạy với Backend Deploy trên Render (Mặc định cho Production / Vercel):
# VITE_API_URL=https://carelink-be.onrender.com
#
# 2. Chạy với Backend Cục bộ (Visual Studio C# .NET cổng 7183):
# VITE_API_URL=https://localhost:7183
#
# 3. Chạy với Backend Cục bộ (Cổng HTTP fallback 5024):
# VITE_API_URL=http://localhost:5024
# ===================================================================

VITE_API_URL=https://carelink-be.onrender.com
